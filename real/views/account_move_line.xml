<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="name">account.move.line.tree</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="mode">extension</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='analytic_distribution']" position="before">
                <field name="analytic_account_display" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_move_line_filter_inherit" model="ir.ui.view">
        <field name="name">account.move.line.search.inherit</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="Analitica"
                        name="group_by_analytic_account_display"
                        domain="[]"
                        context="{'group_by': 'analytic_account_display'}"/>
            </xpath>
        </field>
    </record>
</odoo>
