<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generic_message_wizard_form" model="ir.ui.view">
        <field name="name">generic.message.wizard.form</field>
        <field name="model">generic.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Aviso del Sistema">
                <group>
                    <field name="message" readonly="1"/>
                    <field name="show_continue" invisible="1"/>
                    <field name="target_model" invisible="1"/>
                    <field name="target_res_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_continue" string="Continuar" type="object" class="btn-primary" invisible="not show_continue"/>
                    <button name="action_back" string="Regresar" type="object" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>